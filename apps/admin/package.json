{
  "name": "@voterrule/admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 4001",
    "prebuild": "pnpm --filter \"@voterrule/shared\" --filter \"@voterrule/guidance\" --filter \"@voterrule/i18n\" --filter \"@voterrule/ui\" build",
    "build": "tsc && vite build",
    "built": "pnpm run prebuild && tsc && vite build",
    "preview": "vite preview --port 4001",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@voterrule/guidance": "workspace:*",
    "@voterrule/i18n": "workspace:*",
    "@voterrule/shared": "workspace:*",
    "@voterrule/ui": "workspace:*",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.3"
  }
}
