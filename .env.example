# -----------------------------------------------------------------------------
# VoterRule - Environment Configuration
# Tagline: Every Eligible Voter. Every Right. Every Voice.
# Mode: "demo" (default) or "production"
# -----------------------------------------------------------------------------
APP_MODE=demo
PORT=4000
ADMIN_PORT=4001
WEB_PORT=3000

# Security & Cryptography (32-byte hex keys or KMS ARN)
APP_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
BLIND_INDEX_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
MATCH_TOKEN_SECRET=aabbccddeeff00112233445566778899aabbccddeeff00112233445566778899
SESSION_SECRET=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Database Configuration
# In demo/local mode: falls back to SQLite file if DATABASE_URL is unset
DATABASE_URL=postgresql://voterrule:voterrule_password@localhost:5432/voterrule?sslmode=disable
DATABASE_DRIVER=auto

# Storage (S3 / MinIO / Local)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/documents
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=voterrule-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=ap-south-1

# Official Integration Controls (OFFICIAL_ROLL_ACCESS_ENABLED strictly false unless lawfully authorized)
OFFICIAL_ROLL_ACCESS_ENABLED=false
OFFICIAL_API_BASE_URL=
OFFICIAL_API_KEY=
OFFICIAL_API_AUTHORIZATION_REF=

# Notification Adapters (SMS requires TRAI DLT compliance in India)
SMS_PROVIDER=mock
SMS_DLT_PRINCIPAL_ENTITY_ID=
EMAIL_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=no-reply@voterrule.org

# Antivirus Scanning (ClamAV)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_ENABLED=false

# Privacy & DPDP Officers
DPDP_GRIEVANCE_OFFICER_NAME="Grievance Redressal Officer"
DPDP_GRIEVANCE_OFFICER_EMAIL="grievance@voterrule.org"
DPDP_GRIEVANCE_OFFICER_ADDRESS="New Delhi, India"

# -----------------------------------------------------------------------------
# AI Assistant & Voice Speech-to-Text (VoteRule AI)
# -----------------------------------------------------------------------------
# LLM: Google Gemini 1.5 Flash (offline deterministic fallback if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Whisper Speech-to-Text: Add one of these (browser Web Speech used if empty)
# Option 1 (Recommended for speed & Hinglish): Groq Whisper (console.groq.com)
GROQ_API_KEY=

# Option 2: OpenAI Whisper API (platform.openai.com)
OPENAI_API_KEY=

# Option 3: Custom self-hosted Whisper / Whisper Flow URL
WHISPER_ENDPOINT=
WHISPER_API_KEY=
